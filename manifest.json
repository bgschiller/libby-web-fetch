{
  "manifest_version": 3,
  "name": "Libby Audiobook Downloader",
  "version": "1.0.0",
  "description": "Download audiobooks from Overdrive/Libby",
  "permissions": [
    "webRequest",
    "declarativeNetRequest",
    "downloads",
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.listen.overdrive.com/*",
    "*://libbyapp.com/*",
    "*://odrmediaclips.cachefly.net/*",
    "*://audioclips.cdn.overdrive.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.listen.overdrive.com/*", "*://libbyapp.com/*"],
      "js": ["src/content.js"]
    }
  ]
}
